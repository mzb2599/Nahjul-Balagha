# Copy this file to .env and fill in real values. Never commit .env.

# Required: Google Gemini API key (embeddings + answers)
GEMINI_API_KEY=

# Required: Qdrant connection
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION=nahjul_balagha_ai_gemini

# Optional: book PDF (relative to the project root unless absolute)
# PDF_PATH=Nahjul-Balagha.pdf

# Optional: embedding/index settings
# EMBEDDING_MODEL=gemini-embedding-001
# VECTOR_SIZE=768
# BATCH_SIZE=64

# Optional: API exposure. Keep false for local/private use.
# ALLOW_PUBLIC_API=false
# ALLOWED_HOSTS=localhost,127.0.0.1,::1
# CORS_ORIGINS=http://localhost:5173,https://mzb2599.github.io
